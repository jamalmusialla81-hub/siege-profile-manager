<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SPM.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.dim"><Setter Property="Foreground" Value="#8D96A8" /></Style>
    <Style Selector="TextBlock.h"><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="#596275" /><Setter Property="Margin" Value="0,0,0,8" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="#13161D" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="18" /><Setter Property="Margin" Value="0,0,0,14" /></Style>
    <Style Selector="Button.nav"><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Padding" Value="14,10" /><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="#8D96A8" /><Setter Property="Margin" Value="0,0,0,4" /></Style>
    <Style Selector="Button.nav.on"><Setter Property="Background" Value="#18212C" /><Setter Property="Foreground" Value="#4CC9E8" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#4CC9E8" /><Setter Property="Foreground" Value="#06131A" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="18,10" /></Style>
    <Style Selector="Button.sec"><Setter Property="Background" Value="#1A1E27" /><Setter Property="Padding" Value="16,10" /></Style>
    <Style Selector="Button.tile"><Setter Property="Background" Value="#13161D" /><Setter Property="Foreground" Value="#8D96A8" /><Setter Property="FontSize" Value="11" /><Setter Property="Padding" Value="2" /><Setter Property="Margin" Value="2" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="VerticalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
    <Style Selector="Button.tile.on"><Setter Property="Background" Value="#18303A" /><Setter Property="Foreground" Value="#4CC9E8" /></Style>
    <Style Selector="Button.tile.live"><Setter Property="Foreground" Value="#E9EDF3" /><Setter Property="FontWeight" Value="Bold" /></Style>
    <Style Selector="Button.sec.on"><Setter Property="Background" Value="#18303A" /><Setter Property="Foreground" Value="#4CC9E8" /></Style>
  </Application.Styles>
</Application>
